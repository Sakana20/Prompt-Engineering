{
  "schema_version": "dreamina-interface-config/v3",
  "interface": "dreamina_canvas",
  "catalog_observed_at": null,
  "model_selection_source": "user_requested_pending_runtime_discovery",
  "discovery_required_before_execution": true,
  "task_package": {
    "csv": "<task>.dreamina.csv",
    "plan": "<task>.dreamina.plan.md"
  },
  "canvas": {
    "name_template": "{task_name}-{date}",
    "one_canvas_per_batch": true
  },
  "defaults": {
    "required_video_prompt_phrases": [
      "鼓励人物在口播过程中根据文案语义自然接触、拿起或使用商品，动作真实克制",
      "必须严格按照以下口播文案逐字说完",
      "不得省略、改写、截断或提前结束",
      "不包含任何字幕"
    ]
  },
  "nodes": {
    "image": {
      "name_template": "{task_id}-image",
      "type": "image",
      "model": "seedream_4.6",
      "mode_without_reference": "t2i",
      "mode_with_reference": "i2i",
      "resolution": "1K",
      "ratio_field": "aspect_ratio",
      "count": 1,
      "prompt_field": "image_prompt"
    },
    "video": {
      "name_template": "{task_id}-video",
      "type": "video",
      "model": "seedance_2.0mini",
      "mode": "m2v",
      "resolution": "720p",
      "ratio_field": "aspect_ratio",
      "duration_policy": "explicit_seconds_based_on_script_length_and_model_limits",
      "prompt_field": "video_prompt",
      "prompt_write_timing": "after_image_reference_selected",
      "prompt_template": "以{{node:{image_node_id}}}为参考图生成视频。鼓励人物在口播过程中根据文案语义自然接触、拿起或使用商品，动作真实克制。必须严格按照以下口播文案逐字说完，不得省略、改写、截断或提前结束：“{script}”。口型与口播内容同步，身体动作自然，不包含任何字幕。",
      "required_prompt_phrases": [
        "鼓励人物在口播过程中根据文案语义自然接触、拿起或使用商品，动作真实克制",
        "必须严格按照以下口播文案逐字说完",
        "不得省略、改写、截断或提前结束",
        "不包含任何字幕"
      ],
      "inputs": [
        "image"
      ],
      "count": 1
    }
  },
  "execution_boundary": {
    "create_canvas": false,
    "create_nodes": false,
    "run_nodes": false,
    "requires_user_confirmation_for_paid_generation": true
  },
  "limitations": {
    "spoken_copy": "The video model receives the script in its prompt without a separate TTS node; verbatim speech and voice characteristics must be checked on one approved paid sample before batch use."
  }
}
