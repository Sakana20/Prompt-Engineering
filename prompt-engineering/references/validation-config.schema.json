{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/prompt-engineering/validation-config.schema.json",
  "title": "Copy validation configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "min_characters": {
      "type": "integer",
      "minimum": 1,
      "default": 80
    },
    "max_characters": {
      "type": "integer",
      "minimum": 1,
      "default": 100
    },
    "banned_expressions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "call_to_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "format_prefixes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "forbid_numeric_redpacket_amounts": {
      "type": "boolean",
      "default": false,
      "description": "拒绝阿拉伯数字或中文数字表达的红包金额"
    }
  }
}
