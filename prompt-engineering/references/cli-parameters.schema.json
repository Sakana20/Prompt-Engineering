{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/prompt-engineering/cli-parameters.schema.json",
  "title": "avatar-prompts CLI parameters",
  "oneOf": [
    {
      "title": "compose",
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "anyOf": [
        {"required": ["category"]},
        {"required": ["config"]}
      ],
      "properties": {
        "command": {"const": "compose"},
        "category": {"type": "string", "minLength": 1, "x-cli": "--category"},
        "product_name": {"type": "string", "default": "", "x-cli": "--product-name"},
        "selling_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--selling-point",
          "x-repeatable": true
        },
        "forbidden_claim": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--forbidden-claim",
          "x-repeatable": true
        },
        "preset": {
          "enum": ["taobao-instant-commerce-default", "none"],
          "default": "taobao-instant-commerce-default",
          "x-cli": "--preset"
        },
        "platform": {"type": "string", "default": "", "x-cli": "--platform"},
        "campaign_name": {"type": "string", "default": "", "x-cli": "--campaign-name"},
        "benefit_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--benefit-point",
          "x-repeatable": true
        },
        "config": {
          "type": ["string", "null"],
          "default": null,
          "x-cli": "--config",
          "description": "项目配置 JSON；传入后使用其中的商品和活动口径"
        },
        "output": {"type": ["string", "null"], "default": null, "x-cli": "--output"},
        "count": {"type": "integer", "minimum": 1, "default": 1, "x-cli": "--count"},
        "copy_mode": {
          "enum": ["source_fill", "human_rewrite", "natural_generate"],
          "default": "natural_generate",
          "x-cli": "--copy-mode",
          "description": "只把当前模式所需合同注入创作 Prompt"
        },
        "source_block_id": {
          "type": "string",
          "default": "",
          "x-cli": "--source-block-id",
          "description": "source_fill 或 human_rewrite 使用的单个正式原文块 ID"
        },
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "validate-copy",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "text"],
      "properties": {
        "command": {"const": "validate-copy"},
        "text": {"type": "string", "minLength": 1, "x-cli-position": 1},
        "preset": {
          "enum": ["taobao-instant-commerce-default", "none"],
          "default": "taobao-instant-commerce-default",
          "x-cli": "--preset"
        },
        "platform": {"type": "string", "default": "", "x-cli": "--platform"},
        "campaign_name": {"type": "string", "default": "", "x-cli": "--campaign-name"},
        "benefit_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--benefit-point",
          "x-repeatable": true
        },
        "config": {
          "type": ["string", "null"],
          "default": null,
          "x-cli": "--config",
          "description": "项目配置 JSON；传入后使用其中的活动校验契约"
        },
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "validate-batch",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "input"],
      "properties": {
        "command": {"const": "validate-batch"},
        "input": {"type": "string", "minLength": 1, "x-cli": "--input"},
        "preset": {
          "enum": ["taobao-instant-commerce-default", "none"],
          "default": "taobao-instant-commerce-default",
          "x-cli": "--preset"
        },
        "platform": {"type": "string", "default": "", "x-cli": "--platform"},
        "campaign_name": {"type": "string", "default": "", "x-cli": "--campaign-name"},
        "benefit_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--benefit-point",
          "x-repeatable": true
        },
        "config": {"type": ["string", "null"], "default": null, "x-cli": "--config"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "package",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "input", "format"],
      "properties": {
        "command": {"const": "package"},
        "input": {"type": "string", "minLength": 1, "x-cli": "--input"},
        "format": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["json", "markdown", "segmentation_manuscript", "csv", "libtv_omnihuman_package"]
          },
          "x-cli": "--format",
          "x-repeatable": true
        },
        "output_root": {"type": "string", "x-cli": "--output-root"},
        "date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$", "x-cli": "--date"},
        "preset": {
          "enum": ["taobao-instant-commerce-default", "none"],
          "default": "taobao-instant-commerce-default",
          "x-cli": "--preset"
        },
        "platform": {"type": "string", "default": "", "x-cli": "--platform"},
        "campaign_name": {"type": "string", "default": "", "x-cli": "--campaign-name"},
        "benefit_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--benefit-point",
          "x-repeatable": true
        },
        "config": {"type": ["string", "null"], "default": null, "x-cli": "--config"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "init-batch",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "task_name", "category", "output"],
      "properties": {
        "command": {"const": "init-batch"},
        "task_name": {"type": "string", "minLength": 1, "x-cli": "--task-name"},
        "category": {"type": "string", "minLength": 1, "x-cli": "--category"},
        "count": {"type": "integer", "minimum": 1, "default": 1, "x-cli": "--count"},
        "task_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "default": "TASK",
          "x-cli": "--task-prefix"
        },
        "output": {"type": "string", "minLength": 1, "x-cli": "--output"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "export-csv",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "input"],
      "properties": {
        "command": {"const": "export-csv"},
        "input": {"type": "string", "minLength": 1, "x-cli": "--input"},
        "output_root": {"type": "string", "x-cli": "--output-root"},
        "date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$", "x-cli": "--date"},
        "preset": {
          "enum": ["taobao-instant-commerce-default", "none"],
          "default": "taobao-instant-commerce-default",
          "x-cli": "--preset"
        },
        "platform": {"type": "string", "default": "", "x-cli": "--platform"},
        "campaign_name": {"type": "string", "default": "", "x-cli": "--campaign-name"},
        "benefit_point": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": [],
          "x-cli": "--benefit-point",
          "x-repeatable": true
        },
        "config": {"type": ["string", "null"], "default": null, "x-cli": "--config"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-preflight",
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"const": "learning-preflight"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-transcribe",
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"const": "learning-transcribe"},
        "input": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "显式媒体文件或一级目录；省略时解析当天 /Users/sakana/Desktop/Work/2026/<MM.DD>/淘宝闪购/素材", "x-cli": "--input", "x-repeatable": true},
        "learning_root": {"$ref": "#/$defs/learning_root"},
        "date": {"type": ["string", "null"], "format": "date", "x-cli": "--date"},
        "funasr_python": {"type": "string", "x-cli": "--funasr-python"},
        "model_dir": {"type": "string", "x-cli": "--model-dir"},
        "device": {"type": "string", "default": "mps", "x-cli": "--device"},
        "timeout": {"type": "number", "exclusiveMinimum": 0, "default": 900, "x-cli": "--timeout"}
      }
    },
    {
      "title": "learning-add-person-prompt",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "source_label"],
      "oneOf": [{"required": ["text"]}, {"required": ["input"]}],
      "properties": {
        "command": {"const": "learning-add-person-prompt"},
        "text": {"type": "string", "minLength": 1, "x-cli": "--text"},
        "input": {"type": "string", "minLength": 1, "x-cli": "--input"},
        "source_label": {"type": "string", "default": "用户人工样本", "x-cli": "--source-label"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-list",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "kind"],
      "properties": {
        "command": {"const": "learning-list"},
        "kind": {"$ref": "#/$defs/learning_kind"},
        "status": {"enum": ["pending", "editing", "ready_for_review", "approved", "rejected", "published"]},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-update",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "kind", "candidate_id", "expected_revision", "edited_file"],
      "properties": {
        "command": {"const": "learning-update"},
        "kind": {"$ref": "#/$defs/learning_kind"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "expected_revision": {"$ref": "#/$defs/expected_revision"},
        "edited_file": {"type": "string", "x-cli": "--edited-file"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-submit-review",
      "$ref": "#/$defs/candidate_action",
      "properties": {"command": {"const": "learning-submit-review"}}
    },
    {
      "title": "learning-approve",
      "$ref": "#/$defs/candidate_action",
      "properties": {"command": {"const": "learning-approve"}}
    },
    {
      "title": "learning-reject",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "kind", "candidate_id", "expected_revision", "reason"],
      "properties": {
        "command": {"const": "learning-reject"},
        "kind": {"$ref": "#/$defs/learning_kind"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "expected_revision": {"$ref": "#/$defs/expected_revision"},
        "reason": {"type": "string", "minLength": 1, "x-cli": "--reason"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    {
      "title": "learning-publish",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "kind", "candidate_id", "expected_revision", "manifest"],
      "properties": {
        "command": {"const": "learning-publish"},
        "kind": {"$ref": "#/$defs/learning_kind"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "expected_revision": {"$ref": "#/$defs/expected_revision"},
        "manifest": {"type": "string", "minLength": 1, "x-cli": "--manifest"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    }
  ],
  "$defs": {
    "learning_kind": {"enum": ["copy", "person"], "x-cli": "--kind"},
    "learning_root": {"type": "string", "default": "learning", "x-cli": "--learning-root"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,95}$", "x-cli": "--candidate-id"},
    "expected_revision": {"type": "integer", "minimum": 1, "x-cli": "--expected-revision"},
    "candidate_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "kind", "candidate_id", "expected_revision"],
      "properties": {
        "command": {"type": "string"},
        "kind": {"$ref": "#/$defs/learning_kind"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "expected_revision": {"$ref": "#/$defs/expected_revision"},
        "learning_root": {"$ref": "#/$defs/learning_root"}
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_root": {
          "type": "string",
          "default": "/Users/sakana/Desktop/Work/Codex/Prompt Engineering",
          "x-cli": "--project-root"
        },
        "debug": {"type": "boolean", "default": false, "x-cli": "--debug"},
        "python_executable": {
          "type": ["string", "null"],
          "default": null,
          "x-cli": "--python-executable"
        },
        "arguments": {
          "type": "array",
          "items": {"type": "string"},
          "x-cli-position": "remainder"
        }
      }
    }
  }
}
