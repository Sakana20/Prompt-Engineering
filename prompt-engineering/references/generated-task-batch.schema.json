{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/prompt-engineering/generated-task-batch.schema.json",
  "title": "Codex-generated avatar task batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_name", "category", "tasks"],
  "properties": {
    "schema_version": {"type": "string", "default": "1.0"},
    "task_name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "marked_script",
          "avatar_prompt",
          "identity_key",
          "outfit_key",
          "person_prompt",
          "title"
        ],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "marked_script": {"type": "string", "minLength": 1},
          "avatar_prompt": {"type": "string", "minLength": 1},
          "identity_key": {"type": "string", "minLength": 1},
          "outfit_key": {"type": "string", "minLength": 1},
          "person_prompt": {"type": "string", "minLength": 1},
          "image_prompt": {
            "type": "string",
            "description": "LibTV 首帧 Prompt；省略时复用 person_prompt"
          },
          "title": {"type": "string", "minLength": 1},
          "aspect_ratio": {
            "type": "string",
            "enum": ["9:16", "16:9", "1:1"],
            "default": "9:16"
          },
          "voice": {"type": "string", "default": "明朗女声"},
          "voice_label": {"type": "string", "default": "温暖闺蜜"},
          "voice_id": {
            "type": "string",
            "default": "Chinese (Mandarin)_Warm_Bestie"
          },
          "reference_image_uri": {"type": "string", "default": ""},
          "reference_image_url": {"type": "string", "default": ""},
          "reference_image_pid": {"type": "string", "default": ""},
          "copy_mode": {
            "type": "string",
            "enum": ["source_fill", "human_rewrite", "natural_generate"],
            "description": "文案生成轨道；新批次必须填写。natural_generate 是兼容直填块不足时的无来源降级轨"
          },
          "source_block_id": {
            "type": "string",
            "description": "source_fill 或 human_rewrite 所使用的真人原文块 ID；natural_generate 必须留空"
          },
          "source_slot_values": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "description": "source_fill 实际填入原文块方括号的已确认商品事实；不得填平台、配送或利益点",
            "default": []
          },
          "rewrite_anchor_phrases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "description": "human_rewrite 成稿实际保留的至少两个真人原文字眼",
            "default": []
          },
          "opening_type": {"type": "string", "default": ""},
          "rhythm_type": {"type": "string", "default": ""},
          "need_type": {"type": "string", "default": ""},
          "emotion_type": {"type": "string", "default": ""},
          "identity_tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "outfit_tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "default": []
          }
        }
      }
    }
  }
}
